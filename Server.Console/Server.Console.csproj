<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Crystal Mir2 - 服务器控制台宿主
    作者: asm0x1
    说明: 跨平台控制台应用，替代 Server.MirForms (WinForms)，
          使服务器可在 Linux Docker 容器中运行。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Server.Console</RootNamespace>
    <AssemblyName>Server.Console</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Server\Server.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="log4net.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
